---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SeoHead from "../components/SeoHead.astro";
import ConsentControls from "../components/ConsentControls.astro";
import { getSite } from "../lib/content";
import type { Locale } from "../lib/i18n";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  locale: Locale;
  currentPath: string;
  title: string;
  description: string;
}

const { locale, currentPath, title, description } = Astro.props;
const robots = __POVKH_SITE_MODE__ === "production"
  ? "index, follow, max-image-preview:large"
  : "noindex, nofollow";
const site = await getSite(locale);
const isRu = locale === "ru";
---

<!doctype html>
<html lang={locale} data-site-mode={__POVKH_SITE_MODE__}>
  <head>
    <SeoHead {locale} {currentPath} {title} {description} {robots} />
    <script is:inline>
      document.documentElement.dataset.enhanced = "true";
      document.documentElement.dataset.motion = matchMedia("(prefers-reduced-motion: reduce)").matches ? "reduced" : "standard";
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isRu ? "Перейти к содержанию" : "Skip to content"}</a>
    {__POVKH_SITE_MODE__ !== "production" && <div class="preview-banner" role="status">{site.previewNotice}</div>}
    <Header {locale} {currentPath} {site} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer {locale} />
    <ConsentControls {locale} />
    <script>
      import "../scripts/site";
      import "../scripts/analytics";
    </script>
  </body>
</html>
