---
import { getEntry, render } from "astro:content";
import ContentLayout from "../layouts/ContentLayout.astro";

const entry = await getEntry("legal", "en/cookies");
if (!entry) throw new Error("Missing EN cookie content");
const { Content } = await render(entry);
---
<ContentLayout locale="en" currentPath="/cookies/" title={`${entry.data.title} — Povkh.Dev`} description="Cookie and analytics consent information for Povkh.Dev.">
  <p class="eyebrow">Legal / {entry.data.status}</p>
  <h1>{entry.data.title}</h1>
  <p class="evidence-note" role="status">{entry.data.reviewNotice}</p>
  <Content />
</ContentLayout>
