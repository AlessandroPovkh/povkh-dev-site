---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DualHero from "../../components/home/DualHero.astro";
import ServiceSystems from "../../components/home/ServiceSystems.astro";
import SignatureInteraction from "../../components/home/SignatureInteraction.astro";
import { getFeaturedWork, getProcess, getServices, getSite, getTeam } from "../../lib/content";
import "../../styles/home.css";

const site = await getSite("ru");
const services = await getServices("ru");
const process = await getProcess("ru");
const team = await getTeam("ru");
const featuredWork = await getFeaturedWork("ru");
if (featuredWork.length !== 2) throw new Error("Russian homepage requires exactly two featured cases");
---

<BaseLayout
  locale="ru"
  currentPath="/ru/"
  title={site.meta.title}
  description={site.meta.description}
>
  <DualHero locale="ru" {site} work={featuredWork} />

  <ServiceSystems locale="ru" {services} />
  <SignatureInteraction locale="ru" />

  <section class="process-home" data-section="process" aria-labelledby="process-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow">04 / Прозрачный процесс</p>
        <h2 id="process-title">Пять этапов. Конкретный результат на каждом.</h2>
      </header>
      <ol class="process-list" data-testid="process-list">
        {process.items.map((stage, index) => (
          <li>
            <span class="metadata">0{index + 1}</span>
            <h3>{stage.title}</h3>
            <p>{stage.summary}</p>
            <p class="process-output"><b>Результат:</b> {stage.output}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="studio-home" data-section="studio-summary" data-testid="studio-summary" aria-labelledby="studio-title">
    <div class="studio-home-inner container">
      <div>
        <p class="eyebrow">05 / Студия</p>
        <h2 id="studio-title">Два человека. Одна ответственная система.</h2>
      </div>
      <div class="studio-note">
        <p>{team.intro}</p>
        <a class="button button-secondary" href="/ru/studio/">Как мы работаем</a>
      </div>
    </div>
  </section>

  <section class="final-home" data-section="final-cta" aria-labelledby="final-title">
    <div class="final-home-inner container">
      <div>
        <p class="eyebrow">Начнём с контекста</p>
        <h2 id="final-title">{site.finalCta.title}</h2>
        <p>{site.finalCta.body}</p>
      </div>
      <a class="button" href="/ru/contact/">{site.hero.primaryCta}</a>
    </div>
  </section>
</BaseLayout>
