---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSite } from "../../lib/content";
import { editorialBody, editorialScriptSource, editorialStyles } from "../../lib/ru-home-prototype";
import GlyphField from "../../components/home/GlyphField.astro";
import plexSansCyrillic from "../../assets/fonts/ibm-plex-sans-cyrillic-wght-normal.woff2?url";
import plexSansLatin from "../../assets/fonts/ibm-plex-sans-latin-wght-normal.woff2?url";

const site = await getSite("ru");
const assetRoutes: Record<string, string> = {
  "/files/endokey-product.jpg": "/assets/work/endokey/site-home.jpg",
  "/files/endokey-site.jpg": "/assets/work/endokey/site-home.jpg",
  "/files/kzms-before.jpg": "/assets/work/kzms/catalog-before.jpg",
  "/files/kzms-after.jpg": "/assets/work/kzms/catalog-after.jpg",
  "/files/povkh-lab-home.webp": "/assets/work/povkh-lab/home-en-desktop.webp",
  "/files/povkh-lab-catalog.webp": "/assets/work/povkh-lab/catalog-en-mobile.webp",
  "/files/povkh-lab-release.webp": "/assets/work/povkh-lab/release-en-desktop.webp",
  "/files/povkh-lab-audio.webp": "/assets/work/povkh-lab/audio-player-desktop.webp",
  "/files/povkh-lab-smartlink.webp": "/assets/work/povkh-lab/smartlink-en-desktop.webp",
  "/files/giulia-before-full.png": "/assets/work/giulia/before-full.jpg",
  "/files/giulia-after-full.png": "/assets/work/giulia/after-full.jpg",
};

const replaceAssets = (value: string) => Object.entries(assetRoutes)
  .reduce((result, [from, to]) => result.replaceAll(from, to), value);

const editorialMarkup = replaceAssets(editorialBody)
  .replace(/<div class="hero-macro"[\s\S]*?<\/div>/, "")
  .replace("<main>", '<main id="main-content" tabindex="-1">')
  .replace('alt="Продукт ENDOkey"', 'alt="Интерфейс сайта ENDOkey"')
  .replace(/<button class="review"[\s\S]*?<\/button>/, "")
  .replace('<div class="hero-image"><img', '<div class="hero-image"><img fetchpriority="high" decoding="sync" width="1400" height="788"')
  .replace("Кейс / ENDOkey", "ENDOkey · бренд и сайт")
  .replace('<nav class="site-nav">', '<nav class="site-nav" aria-label="Основная">')
  .replace('<button class="menu-toggle"', '<button class="menu-toggle" data-menu-toggle aria-label="Открыть меню"')
  .replace(
    '<div class="menu-panel" id="menu-panel" aria-hidden="true">',
    '<div class="menu-panel" id="menu-panel" role="dialog" aria-modal="true" aria-label="Навигационное меню" aria-hidden="true">',
  )
  .replace('<a class="logo" href="#hero">', '<a class="logo" href="/ru/">')
  .replaceAll('Povkh<i>.</i>Dev', '<span class="brand-symbol" aria-hidden="true"><svg viewBox="0 0 64 64"><circle cx="27" cy="32" r="18"/><circle class="brand-core" cx="27" cy="32" r="3.25"/><path d="M42.5 22.5 53 15M45 32h14m-16.5 9.5 9 9"/></svg></span><span class="logo-name">Povkh.Dev</span>')
  .replace('<a class="nav-cta mono" href="#final"><span>Обсудить проект</span></a>', '<a class="nav-cta mono" href="/ru/contact/" aria-label="Разобрать задачу"><span>Разобрать задачу</span></a>')
  .replace('<a class="button" href="#final">Разобрать задачу</a>', '<a class="button" href="/ru/contact/" aria-label="Разобрать задачу">Разобрать задачу</a>')
  .replace(
    /<div class="menu-list">[\s\S]*?<\/div><aside/,
    '<div class="menu-list" data-testid="primary-links"><a href="/ru/work/"><span>01</span>Работы</a><a href="/ru/services/"><span>02</span>Услуги</a><a href="/ru/process/"><span>03</span>Процесс</a><a href="/ru/studio/"><span>04</span>Студия</a><a href="/ru/blog/"><span>05</span>Блог</a><a href="/ru/contact/"><span>06</span>Контакт</a></div><aside',
  )
  .replace("Povkh.Dev / Brescia · Москва", '<a href="/" hreflang="en" data-testid="language-switch">English version ↗</a>')
  .replace('<section class="section" id="problems">', '<section class="section" id="problems" data-section="problems">')
  .replace('<div class="problem-visual term-cloud"', '<div class="problem-visual term-cloud" data-visual="translation"')
  .replace('<div class="problem-visual route-map"', '<div class="problem-visual route-map" data-visual="route"')
  .replace('<div class="problem-visual channel-stack"', '<div class="problem-visual channel-stack" data-visual="alignment"')
  .replace('<div class="problem-visual" aria-hidden="true">', '<div class="problem-visual" data-visual="launch" aria-hidden="true">')
  .replace('<section class="section proof" id="proof">', '<section class="section proof" id="proof" data-section="proof">')
  .replace('<section class="section method" id="method">', '<section class="section method" id="method" data-section="method">')
  .replace('<section class="section" id="result">', '<section class="section" id="result" data-section="result">')
  .replace('<section class="final" id="final">', '<section class="final" id="final" data-section="final-cta">')
  .replace('<a class="case-link mono" href="#">Открыть кейс ↗</a>', '<a class="case-link mono" href="/ru/work/kzms/" aria-label="Открыть кейс КЗМС">Открыть кейс ↗</a>')
  .replace('<a class="case-link mono" href="#">Открыть кейс ↗</a>', '<a class="case-link mono" href="/ru/work/endokey/" aria-label="Открыть кейс ENDOkey">Открыть кейс ↗</a>')
  .replace('<a class="case-link mono" href="#">Открыть кейс ↗</a>', '<a class="case-link mono" href="/ru/work/povkh-lab/" aria-label="Открыть кейс POVKH LAB">Открыть кейс ↗</a>')
  .replace('<a class="case-link mono" href="https://giuliapovkh.ru">Смотреть живой сайт ↗</a>', '<a class="case-link mono" href="https://giuliapovkh.ru" rel="external" aria-label="Смотреть живой сайт Giulia Povkh">Смотреть живой сайт ↗</a>')
  .replace('<div class="lab-scroll" data-lab-scroll>', '<div class="lab-scroll" data-lab-scroll tabindex="0" aria-label="Прокручиваемый экран сайта POVKH LAB">')
  .replace('<img src="/assets/work/giulia/before-full.jpg" alt="Старая версия сайта Giulia Povkh">', '<img loading="eager" fetchpriority="low" decoding="async" src="/assets/work/giulia/before-01.jpg" alt="Старая версия сайта Giulia Povkh, верхняя часть"><img loading="lazy" decoding="async" src="/assets/work/giulia/before-02.jpg" alt="Старая версия сайта Giulia Povkh, нижняя часть">')
  .replace('<img src="/assets/work/giulia/after-full.jpg" alt="Новая версия сайта Giulia Povkh">', '<img loading="eager" fetchpriority="low" decoding="async" src="/assets/work/giulia/after-01.jpg" alt="Новая версия сайта Giulia Povkh, часть 1"><img loading="lazy" decoding="async" src="/assets/work/giulia/after-02.jpg" alt="Новая версия сайта Giulia Povkh, часть 2"><img loading="lazy" decoding="async" src="/assets/work/giulia/after-03.jpg" alt="Новая версия сайта Giulia Povkh, часть 3"><img loading="lazy" decoding="async" src="/assets/work/giulia/after-04.jpg" alt="Новая версия сайта Giulia Povkh, часть 4">')
  .replace('<span>Поле исследования</span>', '<span data-research-output>Выберите слой исследования</span>')
  .replace('<div class="research-line" data-index="A"><span>Продукт</span><strong>что выбирают</strong></div>', '<button class="research-line" type="button" aria-pressed="false" data-index="A"><span>Продукт</span><strong>что выбирают</strong></button>')
  .replace('<div class="research-line" data-index="B"><span>Спрос</span><strong>как ищут</strong></div>', '<button class="research-line" type="button" aria-pressed="false" data-index="B"><span>Спрос</span><strong>как ищут</strong></button>')
  .replace('<div class="research-line" data-index="C"><span>Материалы</span><strong>что объясняют</strong></div>', '<button class="research-line" type="button" aria-pressed="false" data-index="C"><span>Материалы</span><strong>что объясняют</strong></button>')
  .replace('<div class="research-line" data-index="D"><span>Продажи</span><strong>где теряются</strong></div>', '<button class="research-line" type="button" aria-pressed="false" data-index="D"><span>Продажи</span><strong>где теряются</strong></button>')
  .replaceAll('<img src="/assets/work/kzms/', '<img loading="lazy" decoding="async" src="/assets/work/kzms/')
  .replace('<img class="after" src="/assets/work/kzms/', '<img class="after" loading="lazy" decoding="async" src="/assets/work/kzms/')
  .replaceAll('<img src="/assets/work/endokey/site-home.jpg"', '<img loading="lazy" decoding="async" src="/assets/work/endokey/site-home.jpg"')
  .replaceAll('<img src="/assets/work/povkh-lab/', '<img loading="lazy" decoding="async" src="/assets/work/povkh-lab/')
  .replace('<img loading="lazy" decoding="async" src="/assets/work/povkh-lab/home-en-desktop.webp" alt="Экран Home', '<img src="/assets/work/povkh-lab/home-en-desktop.webp" alt="Экран Home')
  .replaceAll(' role="tablist"', "")
  .replaceAll(' role="tab"', "")
  .replaceAll(' role="tabpanel"', "")
  .replaceAll(' aria-selected="true"', "")
  .replaceAll(' aria-selected="false"', "")
  .replace('<a class="button" href="#">Разобрать задачу</a>', '<a class="button" href="/ru/contact/?goal=launch" aria-label="Разобрать задачу">Разобрать задачу</a>')
  .replace(
    '<div class="footer-links mono"><a href="#proof">Работы</a><a href="#method">Процесс</a><a href="#final">Обсудить</a></div>',
    '<div class="footer-links mono"><a href="/ru/work/">Работы</a><a href="/ru/process/">Процесс</a><a href="/ru/contact/">Обсудить</a><a href="/ru/privacy/">Конфиденциальность</a><a href="/ru/cookies/">Cookie</a></div>',
  );

const editorialScript = replaceAssets(editorialScriptSource)
  .replace("`${(i+1)*25}%`", "`${((i+1)/caseCards.length)*100}%`")
  .replace("menuPanel?.querySelector('a')?.focus(),260)", "menuPanel?.querySelector('a')?.focus(),520)")
  .replace("tab.setAttribute('aria-selected',String(active));", "")
  .replace("menuToggle?.setAttribute('aria-expanded','false')", "menuToggle?.setAttribute('aria-expanded','false');menuToggle?.setAttribute('aria-label','Открыть меню')")
  .replace("menuToggle?.setAttribute('aria-expanded','true')", "menuToggle?.setAttribute('aria-expanded','true');menuToggle?.setAttribute('aria-label','Закрыть меню')")
  .replace(
    "scene.classList.toggle('is-active',active);scene.setAttribute('aria-hidden',String(!active))",
    "scene.classList.toggle('is-active',active);scene.inert=!active;scene.setAttribute('aria-hidden',String(!active))",
  )
  .replace(/function toggleSelect[\s\S]*$/, "") + `
    const coveredRegions = [
      document.querySelector('#main-content'),
      document.querySelector('.site-footer'),
      document.querySelector('.logo'),
      document.querySelector('.nav-center'),
      document.querySelector('.nav-cta'),
    ];
    const syncMenuModal = () => {
      const open = menuToggle?.getAttribute('aria-expanded') === 'true';
      coveredRegions.forEach(region => { if (region) region.inert = open; });
    };
    const focusOpenMenu = () => {
      if (menuToggle?.getAttribute('aria-expanded') !== 'true' || !menuPanel) return;
      const firstLink = [...menuPanel.querySelectorAll('a[href]')].find(link => link.getClientRects().length > 0);
      if (getComputedStyle(menuPanel).visibility === 'visible' && firstLink) firstLink.focus();
      else requestAnimationFrame(focusOpenMenu);
    };
    menuToggle?.addEventListener('click', () => {
      syncMenuModal();
      if (menuToggle.getAttribute('aria-expanded') === 'true') requestAnimationFrame(focusOpenMenu);
    });
    menuPanel?.querySelectorAll('a').forEach(link => link.addEventListener('click', syncMenuModal));
    addEventListener('keydown', event => {
      if (event.key === 'Escape') syncMenuModal();
      if (event.key !== 'Tab' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
      const focusable = [...menuPanel.querySelectorAll('a[href]')].filter(link => link.getClientRects().length > 0);
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    const researchLayers = [...document.querySelectorAll('.research-line')];
    const researchOutput = document.querySelector('[data-research-output]');
    researchLayers.forEach(layer => layer.addEventListener('click', () => {
      researchLayers.forEach(item => item.setAttribute('aria-pressed', String(item === layer)));
      if (researchOutput) researchOutput.textContent = layer.querySelector('span')?.textContent + ' — ' + layer.querySelector('strong')?.textContent;
    }));
    const motionSections = [...document.querySelectorAll('[data-section]')];
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setMotionState = (section, visible) => {
      section.dataset.motionState = visible ? 'visible' : 'idle';
    };
    if (reduceMotion || !('IntersectionObserver' in window)) {
      motionSections.forEach(section => setMotionState(section, true));
    } else {
      const motionObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => setMotionState(entry.target, entry.isIntersecting));
      }, { rootMargin: '-8% 0px -8% 0px', threshold: .08 });
      motionSections.forEach(section => {
        setMotionState(section, false);
        motionObserver.observe(section);
      });
    }`;
---

<BaseLayout
  locale="ru"
  currentPath="/ru/"
  title={site.meta.title}
  description={site.meta.description}
  shell="immersive"
  bodyClass="editorial-homepage"
  preloadFonts={[plexSansCyrillic, plexSansLatin]}
>
  <style is:global set:html={editorialStyles}></style>
  <style is:global>
    .editorial-homepage { color-scheme: dark; background: transparent; }
    .editorial-homepage #main-content { outline: none; }
    .editorial-homepage [data-section] {
      content-visibility: auto;
      contain-intrinsic-size: auto 1000px;
      scroll-margin-top: calc(var(--nav-h, 80px) + 16px);
    }
    .editorial-homepage .nav-status,
    .editorial-homepage .nav-links a,
    .editorial-homepage .footer-meta,
    .editorial-homepage .signal-track span { color: #aaa6ac; }
    .editorial-homepage .signal-strip h3 span,
    .editorial-homepage .signal-track span:last-of-type { color: #ff5eaa; }
    .editorial-homepage .reveal-panel { opacity: 1; }
    .editorial-homepage .intro-curtain { display: none; }
    .editorial-homepage .page-progress { display: none; }
    .editorial-homepage .ambient-field::after,
    .editorial-homepage .hero-macro { display: none; }
    .editorial-homepage .hero::after,
    .editorial-homepage .proof::before,
    .editorial-homepage .proof::after,
    .editorial-homepage .method::before,
    .editorial-homepage .method::after,
    .editorial-homepage .process-system::before,
    .editorial-homepage .lab-screen-grid,
    .editorial-homepage #problems::before,
    .editorial-homepage #result::before,
    .editorial-homepage .route-map::after { display: none; }
    .editorial-homepage .term-cloud {
      background: radial-gradient(circle at 50% 52%, #ff2f921d, transparent 35%), #09090b;
    }
    .editorial-homepage .process-artifact::before { content: "ПРОЦЕСС"; }
    .editorial-homepage .verify-row::after { content: "ЖДЁТ"; }
    .editorial-homepage .verify-row.is-pass::after { content: "ГОТОВО"; }
    .editorial-homepage .method .eyebrow { color: #a80d4e; }
    .editorial-homepage .process-tab span,
    .editorial-homepage .process-tab strong,
    .editorial-homepage .artifact-head,
    .editorial-homepage .lab-view { color: #aaa6ac; }
    .editorial-homepage .process-copy .mono,
    .editorial-homepage .process-counter span { color: #ff77b9; }
    .editorial-homepage .giulia-case .mono { color: #a4373c; }
    .editorial-homepage .giulia-copy h3 em { color: #b93835; }
    .editorial-homepage .hero-copy,
    .editorial-homepage .hero-art { animation: none; }
    .editorial-homepage .hero-macro img { animation: none; transform: scale(1.02); }
    .editorial-homepage .case-info h3,
    .editorial-homepage .endokey-copy h3 { overflow-wrap: normal; hyphens: none; word-break: normal; }
    .editorial-homepage .process-copy h3 { max-width: 100%; font-size: clamp(48px, 4.5vw, 76px); }
    .editorial-homepage .footer-links { flex-wrap: wrap; }
    .editorial-homepage .menu-side a { color: #ff5eaa; }
    .editorial-homepage .menu-list a span { color: #aaa6ac; }

    /* Quiet-luxury layer: typography first, glass only where it has a job. */
    .editorial-homepage {
      --glass: rgb(20 19 24 / 0.72);
      --glass-strong: rgb(25 23 29 / 0.9);
      --glass-line: rgb(255 255 255 / 0.13);
      --soft-shadow: 0 30px 90px rgb(0 0 0 / 0.38), inset 0 1px 0 rgb(255 255 255 / 0.08);
      background: transparent;
      font-feature-settings: "kern" 1, "liga" 1;
    }
    .editorial-homepage .site-nav {
      top: 12px;
      width: calc(100% - (var(--pad) * 2));
      height: 68px;
      margin: 12px var(--pad) 0;
      padding-inline: 12px 10px;
      border: 1px solid var(--glass-line);
      border-radius: 28px;
      background: linear-gradient(120deg, rgb(34 31 39 / 0.88), rgb(13 13 16 / 0.74));
      box-shadow: 0 18px 60px rgb(0 0 0 / 0.32), inset 0 1px 0 rgb(255 255 255 / 0.1);
      backdrop-filter: blur(28px) saturate(1.25);
    }
    .editorial-homepage .logo {
      padding: 0 12px;
      font-family: "Unbounded Variable", "IBM Plex Sans Variable", sans-serif;
      font-size: 15px;
      font-weight: 560;
      letter-spacing: -0.045em;
    }
    .editorial-homepage .logo::after { display: none; }
    .editorial-homepage .nav-center { gap: 0; }
    .editorial-homepage .nav-center { border-inline: 0; }
    .editorial-homepage .nav-status { display: none; }
    .editorial-homepage .nav-links { gap: 6px; }
    .editorial-homepage .nav-links a {
      min-height: 44px;
      padding-inline: 15px;
      border-radius: 18px;
      color: #d3cfd5;
      font-family: "Unbounded Variable", "IBM Plex Sans Variable", sans-serif;
      font-size: 11px;
      font-weight: 480;
      letter-spacing: -0.035em;
      text-transform: none;
      transition: color .2s ease, background .2s ease;
    }
    .editorial-homepage .nav-links a:hover,
    .editorial-homepage .nav-links a.is-active { color: #fff; background: rgb(255 255 255 / 0.08); }
    .editorial-homepage .nav-cta,
    .editorial-homepage .button {
      min-height: 50px;
      padding: 0 10px 0 22px;
      border: 1px solid rgb(255 255 255 / 0.15);
      border-radius: 999px;
      color: #1a0d14;
      background: linear-gradient(135deg, #ff83bc, #ff3f97 72%);
      box-shadow: 0 12px 34px rgb(255 47 146 / 0.2), inset 0 1px 0 rgb(255 255 255 / 0.48);
      font-family: "Unbounded Variable", "IBM Plex Sans Variable", sans-serif;
      font-size: 14px;
      font-weight: 610;
      letter-spacing: -0.012em;
      text-transform: none;
      transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }
    .editorial-homepage .nav-cta::after,
    .editorial-homepage .button::after {
      display: grid;
      width: 34px;
      height: 34px;
      margin-left: 14px;
      border: 1px solid rgb(22 9 16 / 0.15);
      border-radius: 50%;
      background: rgb(255 255 255 / 0.42);
      content: "↗";
      place-items: center;
    }
    .editorial-homepage .nav-cta:hover,
    .editorial-homepage .button:hover { transform: translateY(-2px); filter: brightness(1.05); box-shadow: 0 18px 42px rgb(255 47 146 / 0.3), inset 0 1px 0 rgb(255 255 255 / 0.52); }
    .editorial-homepage .nav-cta {
      display: inline-flex;
      height: 50px;
      padding: 0 9px 0 18px;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }
    .editorial-homepage .nav-cta::after { width: 30px; height: 30px; margin-left: 10px; }
    .editorial-homepage .nav-cta span { padding-left: 0; }
    .editorial-homepage .menu-toggle {
      height: 50px;
      padding-inline: 16px;
      border-color: var(--glass-line);
      border-radius: 999px;
      background: rgb(255 255 255 / .055);
      font-family: "Unbounded Variable", "IBM Plex Sans Variable", sans-serif;
      font-size: 11px;
      font-weight: 480;
      letter-spacing: -.035em;
      line-height: 1;
      text-transform: none;
    }
    .editorial-homepage .hero {
      min-height: calc(100svh - 92px);
      border-bottom: 0;
      grid-template-columns: minmax(0, 1.08fr) minmax(360px, .92fr);
      column-gap: clamp(40px, 6vw, 110px);
    }
    .editorial-homepage .hero::before { background: radial-gradient(circle at 78% 38%, rgb(255 47 146 / 0.13), transparent 32%); }
    .editorial-homepage .hero-copy { padding-bottom: clamp(40px, 7vh, 90px); }
    .editorial-homepage .hero h1 {
      max-width: 11ch;
      font-weight: 470;
      letter-spacing: -.068em;
      line-height: .88;
    }
    .editorial-homepage .hero-lead { max-width: 38rem; color: #d1cdd2; font-size: clamp(17px, 1.3vw, 20px); line-height: 1.55; }
    .editorial-homepage .hero-art { min-width: 0; }
    .editorial-homepage .hero-scan,
    .editorial-homepage .orbit-note,
    .editorial-homepage .orbit-index,
    .editorial-homepage .rail { display: none; }
    .editorial-homepage .hero-orbit {
      width: min(43vw, 650px);
      aspect-ratio: 1.18;
      padding: 12px 12px 62px;
      border: 1px solid var(--glass-line);
      border-radius: 36px;
      background: linear-gradient(145deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.025));
      box-shadow: var(--soft-shadow);
      backdrop-filter: blur(20px) saturate(1.2);
      transform: perspective(1200px) rotateY(-3deg) rotateX(1deg);
    }
    .editorial-homepage .hero-orbit::before,
    .editorial-homepage .hero-orbit::after { display: none; }
    .editorial-homepage .hero-image {
      inset: 12px 12px 62px;
      border: 1px solid rgb(255 255 255 / 0.12);
      border-radius: 26px;
      background: #111114;
      filter: none;
    }
    .editorial-homepage .hero-image img { object-position: top; }
    .editorial-homepage .hero-image::after { background: linear-gradient(180deg, transparent 72%, rgb(8 8 10 / .28)); }
    .editorial-homepage .orbit-label {
      top: auto;
      right: auto;
      bottom: 14px;
      left: 22px;
      padding: 8px 0;
      border: 0;
      border-radius: 0;
      color: #e9e5e9;
      background: transparent;
