---
import { getEntry, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

const entry = await getEntry("legal", "ru/cookies");
if (!entry) throw new Error("Missing RU cookie content");
const { Content } = await render(entry);
---
<ContentLayout locale="ru" currentPath="/ru/cookies/" title={`${entry.data.title} — Povkh.Dev`} description="Информация о cookie и согласии на аналитику Povkh.Dev.">
  <p class="eyebrow">Правовая информация / {entry.data.status === "draft" ? "черновик" : "утверждено"}</p>
  <h1>{entry.data.title}</h1>
  <p class="evidence-note" role="status">{entry.data.reviewNotice}</p>
  <Content />
</ContentLayout>
