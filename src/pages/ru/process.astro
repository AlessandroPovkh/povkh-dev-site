---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProcess, getSite } from "../../lib/content";

const locale = "ru" as const;
const currentPath = "/ru/process/";
const site = await getSite(locale);
const process = await getProcess(locale);
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={`Процесс — ${site.meta.title}`}
  description="Пять этапов работы Povkh.Dev с понятным результатом для клиента на каждом."
>
  <div class="process-page">
    <section class="process-hero container" aria-labelledby="process-title">
      <p class="eyebrow">02 / Система работы</p>
      <h1 id="process-title">Процесс</h1>
      <p>{process.intro}</p>
    </section>

    <section class="process-stages container" aria-labelledby="stages-title">
      <header class="section-heading">
        <p class="eyebrow">Понять → Сформулировать → Спроектировать → Собрать → Проверить</p>
        <h2 id="stages-title">Между решением и результатом нет чёрного ящика.</h2>
      </header>
      <ol class="stage-list">
        {process.items.map((stage, index) => (
          <li class="stage-item">
            <span class="metadata">0{index + 1}</span>
            <div class="stage-copy">
              <h3>{stage.title}</h3>
              <p>{stage.summary}</p>
            </div>
            <p class="stage-output"><strong>Результат:</strong> {stage.output}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="process-principles container" aria-labelledby="principles-title">
      <h2 id="principles-title">Полезная часть — на виду.</h2>
      <div class="principles-grid">
        <p><strong>Границы остаются явными.</strong><br />У каждого этапа есть согласованное решение или результат, поэтому изменения получают понятное место.</p>
        <p><strong>Качество проверяем в рамках работы.</strong><br />Доступность, производительность, отображение на разных экранах и передача проверяются до завершения работы.</p>
        <p><strong>Одна точка ответственности.</strong><br />Если нужен специалист, Povkh.Dev остаётся ответственным за согласованный результат и коммуникацию.</p>
      </div>
    </section>

    <section class="process-cta container" aria-labelledby="process-cta-title">
      <h2 id="process-cta-title">Готовы принять первое решение?</h2>
      <p>Расскажите о контексте. Мы поможем сформулировать следующий полезный шаг.</p>
      <a class="button" href="/ru/contact/">{site.hero.primaryCta}</a>
    </section>
  </div>
</BaseLayout>

<style>
  .process-page { border-bottom: 1px solid var(--ink); }
  .process-hero { padding-block: clamp(4rem, 10vw, 9rem) var(--space-8); }
  .process-hero h1 { margin-block: var(--space-4) var(--space-5); font-family: var(--font-display); font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -0.07em; line-height: 0.95; }
  .process-hero > p:last-child { max-width: 44rem; font-size: clamp(1.25rem, 2.3vw, 2rem); line-height: 1.25; }
  .process-stages, .process-principles, .process-cta { padding-block: var(--space-8); border-top: 1px solid var(--ink); }
  .section-heading { margin-block-end: var(--space-6); }
  .section-heading h2 { max-width: 22ch; margin-block: var(--space-3) 0; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; }
  .stage-list { margin: 0; padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .stage-item { display: grid; padding-block: var(--space-5); grid-template-columns: 4rem minmax(12rem, 1fr) minmax(16rem, 1.2fr); gap: var(--space-5); border-bottom: 1px solid var(--line); }
  .stage-item h3 { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: clamp(1.4rem, 2.8vw, 2.4rem); letter-spacing: -0.06em; }
  .stage-item p { margin: 0; }
  .stage-output { padding-inline-start: var(--space-5); border-inline-start: 2px solid var(--signal-lime); }
  .process-principles h2 { margin-block: 0 var(--space-6); font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; }
  .principles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .principles-grid p { margin: 0; padding-block-start: var(--space-4); border-top: 2px solid var(--electric-cobalt); }
  .process-cta { display: grid; grid-template-columns: 2fr 2fr auto; align-items: end; gap: var(--space-5); }
  .process-cta h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.5rem); letter-spacing: -0.05em; line-height: 1; }
  .process-cta p { margin: 0; }
  @media (max-width: 56rem) { .stage-item { grid-template-columns: 3rem 1fr; } .stage-output { grid-column: 2; } .principles-grid { grid-template-columns: 1fr; } .process-cta { grid-template-columns: 1fr 1fr; } .process-cta .button { grid-column: 1 / -1; justify-self: start; } }
  @media (max-width: 36rem) { .stage-item { grid-template-columns: 1fr; gap: var(--space-2); } .stage-output { grid-column: auto; } .process-cta { grid-template-columns: 1fr; } }
</style>
