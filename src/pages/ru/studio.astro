---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InnerHeroSignal from "../../components/InnerHeroSignal.astro";
import { getFaq, getSite, getTeam } from "../../lib/content";

const locale = "ru" as const;
const currentPath = "/ru/studio/";
const site = await getSite(locale);
const team = await getTeam(locale);
const faq = await getFaq(locale);
---

<BaseLayout
  locale={locale}
  currentPath={currentPath}
  title={`Студия — ${site.meta.title}`}
  description="Независимая студия Povkh.Dev из двух человек: ответственность остаётся рядом с работой."
>
  <div class="studio-page">
    <section class="studio-hero inner-hero-layout container" aria-labelledby="studio-title">
      <div class="inner-hero-copy">
        <p class="eyebrow">03 / Люди и ответственность</p>
        <h1 id="studio-title">Студия</h1>
        <p class="studio-lede">{team.intro}</p>
      </div>
      <InnerHeroSignal variant="studio" />
    </section>

    <section class="studio-gate container" aria-labelledby="people-title">
      <header class="section-heading">
        <p class="eyebrow">Реальная команда, не сборный профиль</p>
        <h2 id="people-title">Два человека. Одна ответственная система.</h2>
      </header>
      <p class="studio-gate-copy">В постоянной команде — два человека. Публичные профили появятся после утверждения ролей, биографий, портретов и ссылок.</p>
      <div class="founder-records" aria-label="Записи об основателях">
        {team.items.map((founder, index) => (
          <article class="founder-record" data-testid="founder-record">
            <p class="metadata">Запись основателя 0{index + 1}</p>
            <h3>{founder.publicName}</h3>
            <p>Детали профиля основателя будут опубликованы после личного подтверждения.</p>
          </article>
        ))}
      </div>
    </section>

    <section class="collaboration-section container" aria-labelledby="collaboration-title">
      <h2 id="collaboration-title">Близость — часть метода.</h2>
      <div class="collaboration-grid">
        <p><strong>Работа напрямую.</strong><br />Стратегия, дизайн и разработка остаются рядом с теми, кто выполняет работу: меньше передач и понятнее решения.</p>
        <p><strong>Профильные специалисты — по задаче.</strong><br />Если проекту нужен специалист вне постоянной команды, мы подключаем его под согласованную задачу, сохраняя одну точку ответственности внутри Povkh.Dev.</p>
        <p><strong>Доказательства вместо декора.</strong><br />Наш сайт и кейс проекта основателей POVKH LAB показывают системы, которые мы умеем объяснять, тестировать и передавать.</p>
      </div>
    </section>

    <section class="faq-section container" aria-labelledby="faq-title">
      <header class="section-heading"><p class="eyebrow">Рабочие вопросы</p><h2 id="faq-title">Несколько полезных ответов.</h2></header>
      <div class="faq-list">
        {faq.items.map((item) => (
          <details><summary>{item.title}</summary><p>{item.answer}</p></details>
        ))}
      </div>
    </section>

    <section class="studio-cta container" aria-labelledby="studio-cta-title">
      <h2 id="studio-cta-title">Хотите понять, подходим ли мы?</h2>
      <p>Расскажите, что нужно создать, прояснить или соединить.</p>
      <a class="button" href="/ru/contact/">{site.hero.primaryCta}</a>
    </section>
  </div>
</BaseLayout>

<style>
  .studio-page { border-bottom: 1px solid var(--ink); }
  .studio-hero { padding-block: clamp(4rem, 10vw, 9rem) var(--space-8); }
  .studio-hero h1 { margin-block: var(--space-4) var(--space-5); font-family: var(--font-display); font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -0.07em; line-height: 0.95; }
  .studio-lede { max-width: 46rem; font-size: clamp(1.25rem, 2.3vw, 2rem); line-height: 1.25; }
  .studio-gate, .collaboration-section, .faq-section, .studio-cta { padding-block: var(--space-8); border-top: 1px solid var(--ink); }
  .section-heading { margin-block-end: var(--space-6); }
  .section-heading h2 { max-width: 20ch; margin-block: var(--space-3) 0; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; }
  .studio-gate-copy { max-width: 46rem; font-size: 1.2rem; }
  .founder-records { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; border: 1px solid var(--ink); background: var(--ink); }
  .founder-record { padding: var(--space-5); background: var(--paper); }
  .founder-record h3 { margin-block: var(--space-3); font-family: var(--font-display); font-size: clamp(1.25rem, 2.5vw, 2rem); letter-spacing: -0.05em; line-height: 1.1; }
  .collaboration-section h2, .faq-section h2 { margin-block: 0 var(--space-6); font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.5rem); letter-spacing: -0.06em; line-height: 1; }
  .collaboration-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .collaboration-grid p { margin: 0; padding-block-start: var(--space-4); border-top: 2px solid var(--warm-coral); }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { padding-block: var(--space-4); border-bottom: 1px solid var(--line); }
  .faq-list summary { cursor: pointer; font-size: 1.2rem; font-weight: 700; }
  .faq-list p { max-width: 48rem; margin: var(--space-3) 0 0; }
  .studio-cta { display: grid; grid-template-columns: 2fr 2fr auto; align-items: end; gap: var(--space-5); }
  .studio-cta h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.5rem); letter-spacing: -0.05em; line-height: 1; }
  .studio-cta p { margin: 0; }
  @media (max-width: 56rem) { .founder-records, .collaboration-grid { grid-template-columns: 1fr; } .studio-cta { grid-template-columns: 1fr 1fr; } .studio-cta .button { grid-column: 1 / -1; justify-self: start; } }
  @media (max-width: 36rem) { .studio-cta { grid-template-columns: 1fr; } }
</style>
