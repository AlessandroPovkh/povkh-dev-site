---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseChapter from "../../components/work/CaseChapter.astro";
import CaseEvidence from "../../components/work/CaseEvidence.astro";
import CaseXray from "../../components/work/CaseXray.astro";
import { getWorkCase } from "../../lib/content";
import { render } from "astro:content";

const caseStudy = await getWorkCase("en", "povkh-lab");
const { Content } = await render(caseStudy);
const evidenceDate = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeZone: "UTC" }).format(caseStudy.data.evidenceDate);
---

<BaseLayout locale="en" currentPath="/work/povkh-lab/" title="POVKH LAB — Povkh.Dev" description={caseStudy.data.summary}>
  <div class="case-page container">
    <header class="case-hero">
      <div>
        <p class="eyebrow">Founder-led case / verified evidence</p>
        <h1>{caseStudy.data.title}</h1>
      </div>
      <div class="case-hero-note">
        <p>{caseStudy.data.disclosure}</p>
        <p class="metadata">What this case does not claim: unsupported client or commercial results.</p>
        <a class="button button-secondary" href={caseStudy.data.liveSite} rel="external">Visit POVKH LAB ↗</a>
      </div>
    </header>

    <CaseEvidence
      label="Evidence register"
      source={caseStudy.data.publicSource}
      date={evidenceDate}
      text="The narrative and visual artifacts below are derived from the current source branch and its dated QA documentation. Publication rights were confirmed by the owner."
    />

    <CaseChapter id="narrative" kicker="Context / role / method" title="A label system, made legible.">
      <Content />
    </CaseChapter>

    <CaseXray
      audienceImage="/assets/work/povkh-lab/home-en-desktop.webp"
      audienceAlt="Verified pre-launch POVKH LAB website capture showing the label home experience; not concept art."
      audienceCaption="Audience view — verified pre-launch quality-check capture."
      systemImage="/assets/work/povkh-lab/audio-player-desktop.webp"
      systemAlt="Verified POVKH LAB audio player capture showing the catalogue playback system; not concept art."
      systemCaption="System view — verified audio-player quality-check capture."
      audienceText="the catalogue and label language are read as a focused public-facing experience."
      systemText="the same experience is understood as routes, player state, waveform data, and explicit launch gates."
    />

    <CaseChapter id="artifacts" kicker="Evidence / visual sequence" title="Artifacts with a source path.">
      <p>These site captures come from the current POVKH LAB source. They show pre-launch quality-check materials, not campaign concepts or proof of external performance.</p>
      <div class="artifact-grid">
        <figure>
          <img data-case-asset src="/assets/work/povkh-lab/catalog-en-mobile.webp" alt="Verified pre-launch POVKH LAB catalogue capture on a narrow viewport; not concept art." width="375" height="7670" loading="lazy" decoding="async" />
          <figcaption>Catalogue route / responsive capture</figcaption>
        </figure>
        <figure>
          <img data-case-asset src="/assets/work/povkh-lab/release-en-desktop.webp" alt="Verified pre-launch POVKH LAB release-page capture with catalogue metadata; not concept art." width="960" height="2268" loading="lazy" decoding="async" />
          <figcaption>Release route / metadata capture</figcaption>
        </figure>
        <figure>
          <img data-case-asset src="/assets/work/povkh-lab/smartlink-en-desktop.webp" alt="Verified pre-launch POVKH LAB listening chooser capture with platform links; not concept art." width="960" height="682" loading="lazy" decoding="async" />
          <figcaption>Listening chooser / listening-link capture</figcaption>
        </figure>
      </div>
    </CaseChapter>

    <nav class="case-next" aria-label="Case navigation">
      <a href="/work/">← Back to work</a>
      <a href="/ru/work/povkh-lab/">Русская версия →</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .case-page { padding-block: var(--space-8) var(--space-9); }
  .case-hero { display: grid; min-height: 31rem; padding-block: var(--space-6); grid-template-columns: minmax(0, 7fr) minmax(16rem, 5fr); gap: var(--space-7); align-items: end; border-bottom: 1px solid var(--ink); }
  .case-hero h1 { margin: var(--space-5) 0 0; font-family: var(--font-display); font-size: clamp(3.2rem, 9vw, 9rem); letter-spacing: -0.08em; line-height: 0.86; }
  .case-hero-note { padding: var(--space-5); border: 1px solid var(--ink); background: var(--warm-coral); box-shadow: var(--shadow-offset); }
  .case-hero-note p:last-child { margin: 0; }
  .case-page :global(.case-evidence) { max-width: 56rem; margin-block: var(--space-7); }
  .artifact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); }
  .artifact-grid figure { margin: 0; }
  .artifact-grid img { width: 100%; height: 21rem; object-fit: cover; object-position: top; border: 1px solid var(--ink); background: var(--paper-deep); }
  figcaption { margin-top: var(--space-2); color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; }
  .case-next { display: flex; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-6); border-top: 1px solid var(--ink); }
  .case-next a { font-weight: 700; }
  @media (max-width: 56rem) {
    .case-hero { grid-template-columns: 1fr; gap: var(--space-5); }
    .artifact-grid { grid-template-columns: 1fr; }
    .artifact-grid img { height: 20rem; }
  }
  @media (max-width: 36rem) {
    .case-next { align-items: start; flex-direction: column; }
  }
</style>
