---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  currentPath="/services/"
  title="Page not found — Povkh.Dev"
  description="The requested Povkh.Dev page could not be found. Страница не найдена."
>
  <section class="not-found container" data-locale-404="en" lang="en" aria-labelledby="not-found-title-en">
    <p class="eyebrow">404 / Recovery</p>
    <h1 id="not-found-title-en">Page not found</h1>
    <p>That route is not part of this release. The useful next step is still available.</p>
    <nav aria-label="Recovery navigation">
      <a class="button" href="/">Back home</a>
      <a class="button button-secondary" href="/services/">View services</a>
      <a class="text-link" href="/contact/">Discuss a project ↗</a>
    </nav>
  </section>
  <section class="not-found container" data-locale-404="ru" lang="ru" aria-labelledby="not-found-title-ru">
    <p class="eyebrow">404 / Восстановление</p>
    <h1 id="not-found-title-ru">Страница не найдена</h1>
    <p>Такого маршрута нет в этой версии. Следующий полезный шаг всё ещё доступен.</p>
    <nav aria-label="Навигация восстановления">
      <a class="button" href="/ru/">На главную</a>
      <a class="button button-secondary" href="/ru/services/">Посмотреть услуги</a>
      <a class="text-link" href="/ru/contact/">Обсудить проект ↗</a>
    </nav>
  </section>
  <script is:inline>
    document.documentElement.dataset.static404Locale = location.pathname.startsWith("/ru/") ? "ru" : "en";
    document.documentElement.lang = document.documentElement.dataset.static404Locale;
  </script>
</BaseLayout>

<style>
  .not-found { min-height: min(40rem, 70svh); padding-block: clamp(5rem, 14vw, 12rem); }
  .not-found h1 { max-width: 12ch; margin-block: var(--space-4) var(--space-5); font-family: var(--font-display); font-size: clamp(2.8rem, 8vw, 6rem); letter-spacing: -0.07em; line-height: 0.95; }
  .not-found > p:not(.eyebrow) { max-width: 34rem; font-size: 1.3rem; }
  .not-found nav { display: flex; margin-block-start: var(--space-6); flex-wrap: wrap; align-items: center; gap: var(--space-4); }
  html[data-static-404-locale="en"] [data-locale-404="ru"],
  html[data-static-404-locale="ru"] [data-locale-404="en"] { display: none; }
</style>
