---
interface Props {
  kicker: string;
  title: string;
  id: string;
}

const { kicker, title, id } = Astro.props;
---

<section class="case-chapter" id={id} aria-labelledby={`${id}-title`}>
  <header class="case-chapter-heading">
    <p class="case-kicker">{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
  </header>
  <div class="case-chapter-body"><slot /></div>
</section>

<style>
  .case-chapter {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-7);
    padding-block: var(--space-8);
    border-top: 1px solid var(--ink);
  }

  .case-chapter-heading h2 {
    max-width: 14ch;
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 3.6rem);
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .case-kicker {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case-chapter-body :global(p) { max-width: 48rem; }
  .case-chapter-body :global(p:last-child) { margin-bottom: 0; }
  .case-chapter-body :global(ul) { padding-left: 1.25rem; }

  @media (max-width: 56rem) {
    .case-chapter { grid-template-columns: 1fr; gap: var(--space-5); }
    .case-chapter-heading h2 { max-width: 14ch; }
  }
</style>
